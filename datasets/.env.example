# Local settings. Copy to .env; every key is optional.
# Used by ../start.sh when it builds the static website for nginx.
BASE_URL=https://prizeatlas.org/

# Used by website/build.py.
#
# Address published in the footer and on recipient pages as a prefilled correction mailto:.
# Leave it blank or unset to hide the correction links entirely. The build reports which it used:
#   website build config corrections_email=...
CORRECTIONS_EMAIL=

# Optional API key for scripts/lookup_openalex.py. The website build does not read it.
OPENALEX_API=
